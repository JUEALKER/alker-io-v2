---
/**
 * Base layout for every page under /writing.
 * One column, no deck, no overlay. The wordmark top left returns to the deck.
 */
import '../styles/global.css';   // existing global tokens and fonts
import '../styles/writing.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  ogImageAlt?: string;
  publishedTime?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogImageAlt,
  publishedTime,
  ogType = 'article',
  jsonLd,
} = Astro.props;
const site = Astro.site!;
// Vercel preview deployments must never be indexed
const noindex = !!process.env.VERCEL_ENV && process.env.VERCEL_ENV !== 'production';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#E3E1DF" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="Jürgen Alker" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/fonts/MessinaSans-book.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/MessinaSans-semibold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/MessinaSansCondensed-black.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="application/rss+xml" title="Alker — Writing" href={new URL('/writing/rss.xml', site).href} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body class="writing">
    <a class="skip" href="#main">Skip to content</a>
    <a class="wordmark h2" href="/writing">Writing</a>
    <div class="page">
      <main id="main">
        <slot />
      </main>
      <div class="foot"><a class="label" href="/">&larr; Alker</a></div>
    </div>
  </body>
</html>
