---
import Head from '@components/Head.astro';
import Nav from '@components/Nav.astro';
import Dialog from '@components/dialogs/Dialog.astro';
import LegalContent from '@components/dialogs/LegalContent.astro';
import PrivacyContent from '@components/dialogs/PrivacyContent.astro';
import '@styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alker',
  description = 'Alker. The first version of what you can almost see. Jürgen Alker.',
} = Astro.props;

const ogTitle = 'Alker. What if now?';
const ogDescription = 'The first version of what you can almost see. Jürgen Alker.';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/og-image.png', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Alker',
  description: 'The first version of what you can almost see. Jürgen Alker.',
  url: Astro.site!.href,
  sameAs: [
    'https://www.linkedin.com/in/juergenalker/',
    'https://www.instagram.com/alker/',
  ],
  founder: {
    '@type': 'Person',
    name: 'Jürgen Alker',
    email: 'j@alker.io',
    sameAs: [
      'https://www.linkedin.com/in/juergenalker/',
      'https://www.instagram.com/alker/',
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Alker. What if now?" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Schema.org structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="wA40tQyeSUpXamkuNwmL5bw8ANL0ppGiejiwjpwefgM" />

  </head>

  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <div
      class="layout"
      data-js="layout"
      data-color-bg="grey-light"
    >
      <main id="main-content">
        <slot />
      </main>

      <Nav />
    </div>

    <Dialog name="legal" url="/imprint">
      <LegalContent titleId="dialog-legal-title" />
    </Dialog>
    <Dialog name="privacy" url="/privacy">
      <PrivacyContent titleId="dialog-privacy-title" />
    </Dialog>
  </body>
</html>

<style>
  .skip-to-content {
    position: absolute;
    top: -100%;
    left: 0.625rem;
    z-index: 9999;
    padding: 0.5rem 1rem;
    background-color: var(--c-dark);
    color: var(--c-primary);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 0.25rem 0.25rem;
    transition: top 0.2s;
  }

  .skip-to-content:focus {
    top: 0;
  }

  .layout {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100dvh;
    background-color: var(--c-bg);
    transition: background-color 0.4s var(--ease-in-out-custom);
  }

  main {
    flex-grow: 1;
    padding-top: var(--grid-margin);
    display: grid;
  }
</style>

