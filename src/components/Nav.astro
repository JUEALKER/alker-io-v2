---
// The slide inventory: one entry per nav group, slides in deck order.
// Must mirror the <Slide id=...> sequence in src/pages/index.astro —
// markup, aria labels and the per-group bar widths all derive from it.
const sections = [
  { title: 'Alker', aria: 'intro', grow: 3, growDesktop: 3, slides: ['intro', 'intro-1', 'intro-2'] },
  { title: 'About', aria: 'about me', grow: 2, growDesktop: 2, slides: ['about', 'about-1'] },
  {
    title: 'Principles',
    aria: 'principles',
    grow: 4,
    growDesktop: 9,
    slides: ['principles', 'principles-1', 'principles-2', 'principles-3', 'principles-4',
             'principles-5', 'principles-6', 'principles-7', 'principles-8'],
  },
  { title: 'Writing', aria: 'writing', grow: 1, growDesktop: 1, slides: ['writing'] },
  { title: 'Contact', aria: 'contact', grow: 1, growDesktop: 1, slides: ['contact'] },
];
---

<nav class="nav" data-js="nav" role="navigation" aria-label="Page sections">
  <div class="container list">
    {sections.map((section) => (
      <div class="section" style={`--grow: ${section.grow}; --grow-desktop: ${section.growDesktop}`}>
        <span class="title">{section.title}</span>
        <ul>
          {section.slides.map((id, i) => (
            <li>
              <a
                href={`#${id}`}
                aria-label={`to ${section.aria}${i > 0 ? ` part ${i + 1}` : ''}`}
                data-js="nav-link"
                class:list={[{ 'is-active': id === 'intro' }]}
              >
                <span class="bar"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</nav>

<style>
  .nav {
    color: var(--c-dark);
    transition: color 0.4s var(--ease-in-out-custom);
  }

  .nav.is-dark {
    color: var(--c-light);
  }

  .list {
    display: flex;
    gap: 0.25rem;
  }

  .section {
    position: relative;
    flex-grow: var(--grow);
  }

  .title {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    font-size: clamp(
      0.75rem,
      200 / (var(--fluid-max) - var(--fluid-min)) * 1vw +
        (var(--fluid-min) * 14 - var(--fluid-max) * 12) /
        (var(--fluid-min) - var(--fluid-max)) / 16 * 1rem,
      0.875rem
    );
    pointer-events: none;
  }

  ul {
    display: flex;
    list-style: none;
  }

  li {
    flex-grow: 1;
  }

  /* On mobile: only first item is clickable per section */
  li:not(:first-child) {
    pointer-events: none;
  }

  /* Fill all preceding items when a later sibling is active */
  li:has(~ li.is-active) .bar::after {
    transform: scaleX(1);
  }

  /* Rounded left caps for first item */
  li:first-child a .bar::before,
  li:first-child a .bar::after {
    border-top-left-radius: 999px;
    border-bottom-left-radius: 999px;
  }

  /* Rounded right caps for last item */
  li:last-child a .bar::before,
  li:last-child a .bar::after {
    border-top-right-radius: 999px;
    border-bottom-right-radius: 999px;
  }

  a {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 2.125rem;
    -webkit-tap-highlight-color: transparent;
    outline: none;
  }

  a:focus-visible {
    outline: revert;
  }

  /* Large touch target on mobile */
  a::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* Auto-advance animation on active item */
  a.is-active:not(.is-paused) .bar::after {
    animation: fill 8s linear 0s 1 normal forwards;
  }

  .bar {
    position: relative;
    display: block;
    width: 100%;
    height: 0.125rem;
    margin-bottom: 0.625rem;
  }

  .bar::before,
  .bar::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-color: currentColor;
  }

  .bar::before {
    opacity: 0.3;
    border-radius: 999px;
  }

  .bar::after {
    opacity: 1;
    transform: scaleX(0);
    transform-origin: left;
  }

  @media (min-width: 768px) {
    .section { flex-grow: var(--grow-desktop); }

    ul {
      gap: 0.25rem;
    }

    /* All items clickable on desktop */
    li:nth-child(n) {
      pointer-events: all;
    }

    /* No fill-forward on desktop; each item animates independently */
    li:has(~ li.is-active) .bar::after {
      transform: scaleX(0);
    }

    a::before {
      display: none;
    }

    .bar::before,
    .bar::after {
      border-radius: 999px;
    }
  }

  @keyframes fill {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
</style>

<script>
  import VirtualScroll from 'virtual-scroll';

  const layout   = document.querySelector<HTMLElement>('[data-js="layout"]');
  const nav      = document.querySelector<HTMLElement>('[data-js="nav"]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-js="nav-link"]');
  const touchAreas = document.querySelectorAll<HTMLElement>('[data-js="touch-area"]');
  const dialogLegal   = document.querySelector<HTMLDialogElement>('[data-js="dialog-legal"]');
  const dialogPrivacy = document.querySelector<HTMLDialogElement>('[data-js="dialog-privacy"]');

  // theme-color follows the slide background; hex values come from the
  // --c-* design tokens so a palette change needs no second edit here
  const rootStyles = getComputedStyle(document.documentElement);
  const tokenColor = (name: string) => rootStyles.getPropertyValue(`--c-${name}`).trim();

  let timer: ReturnType<typeof setInterval>;
  let isThrottled = false;

  const getActiveIndex = () =>
    Array.from(navLinks).findIndex(l => l.classList.contains('is-active'));

  const goTo = (link: HTMLAnchorElement) => {
    resetTimer();
    dialogLegal?.close();
    dialogPrivacy?.close();

    navLinks.forEach(l => {
      l.classList.remove('is-active', 'is-paused');
      l.parentElement?.classList.remove('is-active');
    });

    link.classList.add('is-active');
    link.parentElement?.classList.add('is-active');

    document.querySelector<HTMLElement>('[data-js="slide"].is-active')?.classList.remove('is-active');

    const targetId = link.getAttribute('href')?.replace('#', '') ?? '';
    const slide = document.getElementById(targetId);

    if (slide && layout) {
      slide.classList.add('is-active');
      const bg = slide.dataset.colorBg ?? 'primary';
      layout.dataset.colorBg = bg;

      const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
      themeColor?.setAttribute('content', tokenColor(bg) || '#DCFF00');

      if (bg === 'grey-dark') {
        nav?.classList.add('is-dark');
      } else {
        nav?.classList.remove('is-dark');
      }
    }
  };

  const prev = () => {
    const i = getActiveIndex();
    goTo(i > 0 ? navLinks[i - 1] : navLinks[navLinks.length - 1]);
  };

  const next = () => {
    const i = getActiveIndex();
    goTo(i < navLinks.length - 1 ? navLinks[i + 1] : navLinks[0]);
  };

  const resetTimer = () => {
    clearInterval(timer);
    timer = setInterval(next, 8000);
  };

  // Click on nav links
  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      goTo(link);
    });
  });

  // Keyboard navigation
  window.addEventListener('keydown', (e) => {
    if (dialogLegal?.open || dialogPrivacy?.open) return;
    if (e.key === 'ArrowLeft') prev();
    if (e.key === 'ArrowRight') next();
  });

  // Scroll / swipe navigation
  interface VirtualScrollEvent {
    x: number;
    y: number;
    deltaX: number;
    deltaY: number;
    originalEvent: Event;
  }

  const vs = new VirtualScroll();
  vs.on((e: VirtualScrollEvent) => {
    if (e.originalEvent.type === 'keydown') return;
    if (dialogLegal?.open || dialogPrivacy?.open) return;
    if (isThrottled) return;

    const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
    if (Math.abs(delta) > 20) {
      delta < 0 ? next() : prev();
      isThrottled = true;
      setTimeout(() => { isThrottled = false; }, 1000);
    }
  });

  // Touch area click → advance
  touchAreas.forEach(area => {
    area.addEventListener('click', (e) => {
      if ((e.target as Element)?.closest('a, button, input, select, textarea')) return;
      e.preventDefault();
      next();
    });
  });

  // External nav control events
  window.addEventListener('nav:stop', () => {
    clearInterval(timer);
    navLinks[getActiveIndex()]?.classList.add('is-paused');
  });

  window.addEventListener('nav:start', () => {
    goTo(navLinks[getActiveIndex()]);
  });

  // Pause the auto-advance while the tab is hidden
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) clearInterval(timer);
    else resetTimer();
  });

  // Activate first slide on init
  goTo(navLinks[0]);
  window.addEventListener('load', () => { history.replaceState(null, '', ' '); });
</script>
